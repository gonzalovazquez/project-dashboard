{
  "name": "project-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop dashboard for finishing local projects",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/main/cli.ts",
    "notion:setup": "tsx src/main/notion/cli.ts setup",
    "notion:pull": "tsx src/main/notion/cli.ts pull",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "bash scripts/smoke.sh",
    "ui-check": "npm run build --silent && for v in full sparse untracked empty scanning scanning-empty firstrun broken crash; do tsx scripts/make-sample.ts $v; done && node scripts/ui-check.mjs",
    "package": "npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --dir",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.1"
  },
  "main": "./out/main/index.js",
  "author": "Gonzalo Vazquez",
  "build": {
    "appId": "com.gonzalovazquez.project-dashboard",
    "productName": "Project Dashboard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "dir"
    }
  }
}
