{
  "name": "project-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop dashboard for finishing local projects",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "tsx src/main/cli.ts",
    "notion:setup": "tsx src/main/notion/cli.ts setup",
    "notion:pull": "tsx src/main/notion/cli.ts pull",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "bash scripts/smoke.sh",
    "ui-check": "npm run build --silent && for v in full sparse untracked empty scanning scanning-empty; do tsx scripts/make-sample.ts $v; done && node scripts/ui-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "main": "./out/main/index.js"
}
